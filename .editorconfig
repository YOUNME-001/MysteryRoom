root = true

########################################
# Global
########################################

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4

########################################
# C#
########################################

[*.cs]

########################################
# using 정렬
########################################

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

########################################
# var 사용 규칙
########################################

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

########################################
# expression body
########################################

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion

########################################
# braces
########################################

csharp_new_line_before_open_brace = all

########################################
# switch indentation
########################################

csharp_indent_case_contents = true
csharp_indent_switch_labels = true

########################################
# Naming Rules
########################################

# private field → _camelCase
dotnet_naming_rule.private_fields_rule.severity = suggestion
dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = private_field_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.private_field_style.required_prefix = _
dotnet_naming_style.private_field_style.capitalization = camel_case

# public member → PascalCase
dotnet_naming_rule.public_members_rule.severity = suggestion
dotnet_naming_rule.public_members_rule.symbols = public_members
dotnet_naming_rule.public_members_rule.style = pascal_case_style

dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_symbols.public_members.applicable_kinds = method, property, field

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

########################################
# constants → ALL_CAPS
########################################

dotnet_naming_rule.const_rule.severity = suggestion
dotnet_naming_rule.const_rule.symbols = const_fields
dotnet_naming_rule.const_rule.style = const_style

dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.required_modifiers = const

dotnet_naming_style.const_style.capitalization = all_upper